 "nodes": [
  {
   "id": "n1",
   "type": "text",
   "x": 0,
   "y": 0,
   "width": 300,
   "height": 690,
   "text": "## 操作系统\n\n5 章 · **157** 个考点\n\n[[操作系统·考点总览]]",
   "color": "#74A0E2"
  },
  {
   "id": "n2",
   "type": "text",
   "x": 430,
   "y": 0,
   "width": 340,
   "height": 730,
   "text": "**第1章 计算机系统概述**\n\nPDF p13–48\n原书 p.1–36\n\n[[O01 操作系统 第01章 计算机系统概述/本章复盘]]",
   "color": "#1261D9"
  },
  {
   "id": "n3",
   "type": "text",
   "x": 880,
   "y": 100,
   "width": 430,
   "height": 78,
   "text": "两种模式下发生或执行的事件分析\n`4 年 · 2011、2012、2014、2021`",
   "color": "#D3DEEE"
  },
  {
   "id": "n4",
   "type": "text",
   "x": 880,
   "y": 200,
   "width": 430,
   "height": 78,
   "text": "系统调用的处理过程及相关分析\n`4 年 · 2012、2017、2022、2023`",
   "color": "#D3DEEE"
  },
  {
   "id": "n5",
   "type": "text",
   "x": 880,
   "y": 300,
   "width": 430,
   "height": 78,
   "text": "中断和异常的处理过程\n`3 年 · 2015、2020、2024`",
   "color": "#D3DEEE"
  },
  {
   "id": "n6",
   "type": "text",
   "x": 880,
   "y": 400,
   "width": 430,
   "height": 78,
   "text": "系统调用的定义、功能及性质\n`3 年 · 2019、2021、2024`",
   "color": "#D3DEEE"
  },
  {
   "id": "n7",
   "type": "text",
   "x": 880,
   "y": 500,
   "width": 430,
   "height": 78,
   "text": "可能引发中断或异常的指令分析\n`2 年 · 2013、2015`",
   "color": "#D3DEEE"
  },
  {
   "id": "n8",
   "type": "text",
   "x": 880,
   "y": 600,
   "width": 430,
   "height": 78,
   "text": "多道批处理系统特点\n`2 年 · 2017、2022`",
   "color": "#D3DEEE"
  },
  {
   "id": "n9",
   "type": "text",
   "x": 430,
   "y": 775,
   "width": 340,
   "height": 730,
   "text": "**第2章 进程与线程**\n\nPDF p49–187\n原书 p.37–175\n\n[[O02 操作系统 第02章 进程与线程/本章复盘]]",
   "color": "#1261D9"
  },
  {
   "id": "n10",
   "type": "text",
   "x": 880,
   "y": 875,
   "width": 430,
   "height": 78,
   "text": "PV操作的应用题\n`8 年 · 2009、2011、2013、2014、2015、2017、2019、2025`",
   "color": "#D3DEEE"
  },
  {
   "id": "n11",
   "type": "text",
   "x": 880,
   "y": 975,
   "width": 430,
   "height": 78,
   "text": "引起进程状态转换的事件\n`5 年 · 2014、2015、2018、2023、2025`",
   "color": "#D3DEEE"
  },
  {
   "id": "n12",
   "type": "text",
   "x": 880,
   "y": 1075,
   "width": 430,
   "height": 78,
   "text": "银行家算法安全序列分析\n`5 年 · 2011、2012、2018、2020、2022`",
   "color": "#D3DEEE"
  },
  {
   "id": "n13",
   "type": "text",
   "x": 880,
   "y": 1175,
   "width": 430,
   "height": 78,
   "text": "各种调度算法特点与对比\n`3 年 · 2009、2011、2014`",
   "color": "#D3DEEE"
  },
  {
   "id": "n14",
   "type": "text",
   "x": 880,
   "y": 1275,
   "width": 430,
   "height": 78,
   "text": "同步与互斥的相关分析\n`3 年 · 2016、2021、2023`",
   "color": "#D3DEEE"
  },
  {
   "id": "n15",
   "type": "text",
   "x": 880,
   "y": 1375,
   "width": 430,
   "height": 78,
   "text": "线程的特点\n`3 年 · 2011、2019、2024`",
   "color": "#D3DEEE"
  },
  {
   "id": "n16",
   "type": "text",
   "x": 430,
   "y": 1550,
   "width": 340,
   "height": 730,
   "text": "**第3章 内存管理**\n\nPDF p188–262\n原书 p.176–250\n\n[[O03 操作系统 第03章 内存管理/本章复盘]]",
   "color": "#1261D9"
  },
  {
   "id": "n17",
