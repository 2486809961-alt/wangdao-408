  "customCommands": [
    {
      "id": "wd-stem",
      "name": "题干卡",
      "icon": "lucide-square-pen",
      "useRegex": true,
      "regexPattern": "(?s)^\\s*([\\s\\S]*?)\\s*$",
      "regexReplacement": "> [!question] 题干\n> $1",
      "regexCaseInsensitive": false,
      "regexGlobal": false,
      "regexMultiline": true,
      "useCondition": false,
      "conditionPattern": "",
      "prefix": "",
      "suffix": "",
      "char": 0,
      "line": 0,
      "islinehead": false
    },
    {
      "id": "wd-opts",
      "name": "选项网格",
      "icon": "lucide-columns-2",
      "useRegex": true,
      "regexPattern": "(?m)^\\s*([A-D])\\s*[.、．)）]\\s*(.+)$",
      "regexReplacement": "<div class=\"wd-opt\"><b>$1</b><span>$2</span></div>",
      "regexCaseInsensitive": false,
      "regexGlobal": true,
      "regexMultiline": true,
      "useCondition": false,
      "conditionPattern": "",
      "prefix": "",
      "suffix": "",
      "char": 0,
      "line": 0,
      "islinehead": false
    },
    {
      "id": "wd-ans",
      "name": "答案牌",
      "icon": "lucide-badge-check",
      "useRegex": true,
      "regexPattern": "^\\s*([A-D])\\s*$",
      "regexReplacement": "<span class=\"wd-ans\">$1</span>",
      "regexCaseInsensitive": false,
      "regexGlobal": true,
      "regexMultiline": true,
      "useCondition": false,
      "conditionPattern": "",
      "prefix": "",
      "suffix": "",
      "char": 0,
      "line": 0,
      "islinehead": false
    },
    {
      "id": "wd-page",
      "name": "页码章",
      "icon": "lucide-file-digit",
      "useRegex": true,
      "regexPattern": "(\\d{1,4})\\s*页",
      "regexReplacement": "<span class=\"wd-page\">p$1</span>",
      "regexCaseInsensitive": false,
      "regexGlobal": true,
      "regexMultiline": false,
      "useCondition": false,
      "conditionPattern": "",
      "prefix": "",
      "suffix": "",
      "char": 0,
      "line": 0,
      "islinehead": false
    }
  ],
